# All optional. The app runs with none of these set.

# Basic auth. Set APP_PASSWORD to require a login; APP_USERNAME defaults to "gilt".
# On Northflank plans that only offer secret FILES, mount these at
# /etc/secrets/APP_PASSWORD instead and leave the env vars unset.
# APP_USERNAME=gilt
# APP_PASSWORD=

# Where the cached Bank of England curve snapshot is written.
# Defaults to ./data. On an ephemeral filesystem the app still works - it just
# refetches the curve after each restart.
# DATA_DIR=/var/lib/gilt-ladder

# PORT=3000
