# No environment variables are required. The app now reads directly from the
# FCA's National Storage Mechanism (data.fca.org.uk), which needs no API key.
#
# Optional: override the local dev server's port (defaults to 3000).
# PORT=3000

# Optional: how long (minutes) each company's NSM results are cached
# in-memory before being re-fetched. Defaults to 10. Set to 0 to disable
# caching entirely (always fetch fresh). Only effective on a persistent
# process (Render, local dev) - Vercel's serverless functions don't
# guarantee shared memory between invocations, so this cache is largely
# ineffective there.
# NSM_CACHE_TTL_MINUTES=10

# Required for the "Summarise" button on each report to work. Points at a
# self-hosted, open-weight LLM's OpenAI-compatible /chat/completions
# endpoint - NOT a hosted third-party API (no OpenAI/Anthropic/etc. key
# involved anywhere). Ollama (via its /v1 compatibility layer), llama.cpp's
# server, vLLM, LocalAI, and text-generation-webui's openai extension all
# speak this same shape. See README.md's "Summarise" section for setup
# steps and a real Ollama example.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Optional: only needed if your self-hosted server sits behind its own
# bearer-token auth (most local Ollama/llama.cpp setups don't).
# LLM_API_KEY=

# Optional: how many characters of extracted document text to send in the
# prompt (defaults to 8000). Lower this for a smaller/slower local model,
# raise it if your model has a large context window and you want richer
# summaries of long filings.
# LLM_MAX_INPUT_CHARS=8000
