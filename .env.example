# Copy this file to .env and fill in your real key for local development.
# Never commit the real .env file.
TICKER_API_KEY=your_ticker_api_key_here

# Optional: max Ticker API requests (pageCursor pages) per report refresh.
# Ticker's isins filter doesn't restrict results server-side, so the app
# paginates the general feed itself - see README for the quota tradeoff.
# Defaults to 10 if unset.
# TICKER_MAX_PAGES=10
