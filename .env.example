# No environment variables are required. The app now reads directly from the
# FCA's National Storage Mechanism (data.fca.org.uk), which needs no API key.
#
# Optional: override the local dev server's port (defaults to 3000).
# PORT=3000

# RESEND_API_KEY, NOTIFY_EMAIL_FROM, NOTIFY_EMAIL_TO, DATABASE_URL,
# DATABASE_SSL_CA, APP_USERNAME, APP_PASSWORD, and VIEW_TOKEN_SECRET below can each be provided as a file instead
# of an env var, for platforms that only support mounting secret files (e.g.
# some Northflank plans) - see README.md's "Secret files instead of secret
# variables" section.

# Without this, the whole app (every page and API route) is open to anyone
# with the URL - that's the default, unchanged behaviour. Set APP_PASSWORD to
# require an HTTP Basic Auth login (the browser's native username/password
# prompt) before anything loads, on every deployment method (server.js
# itself checks it for local/Render/Northflank; middleware.js does the same
# for Vercel). Username defaults to "admin" if APP_USERNAME isn't set.
# Also required for the in-app notification recipient to be used - without
# it, /api/notify only ever sends to NOTIFY_EMAIL_TO (see below).
# APP_USERNAME=admin
# APP_PASSWORD=choose-a-real-password

# Optional: encrypts shareable links. With this set, the address-bar URL, the
# RSS feed link, and the app's own report requests carry one opaque `v`
# token (AES-256-GCM, lib/viewToken.js) instead of readable company LEIs and
# settings - so your watchlist doesn't show up in browser history, hosting
# request logs, or link previews. Anyone who opens a link still sees that
# view (APP_PASSWORD is what controls access). Must be at least 32
# characters - e.g. the output of `openssl rand -base64 32`. Changing it
# breaks every existing encrypted link and RSS feed URL. Without it, links
# stay readable, as before.
# VIEW_TOKEN_SECRET=

# Optional: how long (minutes) each company's NSM results are cached
# before being re-fetched. Defaults to 10. Set to 0 to disable caching
# entirely (always fetch fresh).
# NSM_CACHE_TTL_MINUTES=10

# Optional: a Postgres connection string. When set, the NSM result cache
# above is stored in Postgres (lib/cacheStore.js) instead of an in-memory
# Map, so it survives a Render free-tier web service spinning down and
# cold-starting again - without this, a cold start wipes the cache and
# re-hits NSM for every watched company at once. With no DATABASE_URL, the
# app behaves exactly as before (in-memory only, zero setup needed). See
# README.md's "Persistent cache (Postgres)" section for setup and a caveat
# about Render's own free-tier Postgres databases.
#
# Also required for automatic email digests (the Notifications overlay,
# lib/subscriptionStore.js) - unlike the cache, that feature has no
# in-memory fallback, since a subscription has to survive process restarts
# to mean anything as "automatic". See README.md's "Automatic email
# digests" section.
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# The database's TLS certificate is verified by default. If your provider's
# certificate isn't signed by a CA in Node's default trust store, set
# DATABASE_SSL_CA to the provider's CA certificate (PEM text). Only as a last
# resort, DATABASE_SSL_VERIFY=false skips verification (still encrypted, but
# open to interception). An `sslmode` in DATABASE_URL overrides both.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DATABASE_SSL_VERIFY=false

# Required for the "Send Notification" button on each report to work.
# Sends via the Resend API (lib/sendNotification.js). These are secrets, so
# they must be set here (server-side) - there's no UI for them - and
# /api/notify returns an error naming what's missing if any are absent. This
# is entirely optional - without it the app runs the same, minus that button.
# See README.md's "Email notifications" section for full setup steps
# (signup, sender/domain verification, API key creation).
#
# RESEND_API_KEY=re_your_api_key
#
# The address emails are sent from. Must be a verified sender: either
# onboarding@resend.dev (Resend's shared testing address - only delivers to
# the email you signed up to Resend with) or an address on a domain you've
# verified with Resend.
# NOTIFY_EMAIL_FROM=you@example.com

# Optional: this deployment's own public URL, with no trailing slash (e.g.
# https://rns-update.onrender.com). When set, every automatic digest email's
# footer includes a "Manage notification preferences" link straight back to
# the Notifications overlay (${APP_URL}/#notifications) - see
# lib/sendDigest.js's wrapEmail() and app.js's `#notifications` hash
# handling. Without it, the footer link is simply omitted.
# APP_URL=https://your-deployment.example.com

# Recipient. Each browser prompts for and remembers its own recipient
# address via an in-app overlay (see the "Notification email" panel / the
# first "Send Notification" click), sent as `to` in the request - but that's
# only honoured when APP_PASSWORD is set. Without APP_PASSWORD this is
# required, and is the only address emails are ever sent to (a request
# naming any other recipient is refused), so an open deployment can't be
# used to mail arbitrary addresses. With APP_PASSWORD it's an optional
# fallback for a request that doesn't supply its own `to`.
# NOTIFY_EMAIL_TO=you@example.com
