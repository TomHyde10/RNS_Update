# No environment variables are required. The app now reads directly from the
# FCA's National Storage Mechanism (data.fca.org.uk), which needs no API key.
#
# Optional: override the local dev server's port (defaults to 3000).
# PORT=3000

# Optional: how long (minutes) each company's NSM results are cached
# in-memory before being re-fetched. Defaults to 10. Set to 0 to disable
# caching entirely (always fetch fresh). Only effective on a persistent
# process (Render, local dev) - Vercel's serverless functions don't
# guarantee shared memory between invocations, so this cache is largely
# ineffective there.
# NSM_CACHE_TTL_MINUTES=10

# Required for the "Send Notification" button on each report to work.
# Standard SMTP credentials for whichever mailbox/service should send the
# notification email (e.g. Gmail with an app password, SendGrid, Mailgun,
# your own mail server). All five must be set or /api/notify returns an
# error naming what's missing - nothing is sent with defaults/guessed values.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password-or-app-password
# NOTIFY_EMAIL_FROM=you@example.com
# NOTIFY_EMAIL_TO=you@example.com
