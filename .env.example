# No environment variables are required. The app now reads directly from the
# FCA's National Storage Mechanism (data.fca.org.uk), which needs no API key.
#
# Optional: override the local dev server's port (defaults to 3000).
# PORT=3000

# Optional: how long (minutes) each company's NSM results are cached
# in-memory before being re-fetched. Defaults to 10. Set to 0 to disable
# caching entirely (always fetch fresh). Only effective on a persistent
# process (Render, local dev) - Vercel's serverless functions don't
# guarantee shared memory between invocations, so this cache is largely
# ineffective there.
# NSM_CACHE_TTL_MINUTES=10

# Required for the "Send Notification" button on each report to work.
# Standard SMTP credentials for whichever mailbox/service should send the
# notification email. These are secrets, so they must be set here
# (server-side) - there's no UI for them - and /api/notify returns an error
# naming what's missing if any are absent. The sending account does NOT need
# to be the same as the recipient (see NOTIFY_EMAIL_TO below) - e.g. you can
# send via SendGrid while the notification still lands in a mailbox that
# can't itself send (an org Microsoft 365 account with SMTP AUTH disabled,
# for example). See README.md's "Email notifications" section for full
# setup steps (SendGrid sender verification, API key creation, etc).
#
# SendGrid (recommended - free tier, works when your own mailbox can't send):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# NOTIFY_EMAIL_FROM=your-verified-sender@example.com
#
# Or your own mailbox directly, e.g. Gmail with an app password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# NOTIFY_EMAIL_FROM=you@example.com

# Optional: default recipient, used only when a request doesn't supply its
# own "to". The app itself no longer needs this set - each browser now
# prompts for and remembers its own recipient address via an in-app overlay
# (see the "Notification email" panel / the first "Send Notification"
# click), sent as `to` in the request. Set this only if you want a
# server-wide fallback recipient regardless of what any browser has saved.
# NOTIFY_EMAIL_TO=you@example.com
