# No environment variables are required. The app now reads directly from the
# FCA's National Storage Mechanism (data.fca.org.uk), which needs no API key.
#
# Optional: override the local dev server's port (defaults to 3000).
# PORT=3000

# Optional: how long (minutes) each company's NSM results are cached
# in-memory before being re-fetched. Defaults to 10. Set to 0 to disable
# caching entirely (always fetch fresh). Only effective on a persistent
# process (Render, local dev) - Vercel's serverless functions don't
# guarantee shared memory between invocations, so this cache is largely
# ineffective there.
# NSM_CACHE_TTL_MINUTES=10

# Required for the "Summarise" button on each report to work. Calls the
# Claude API (official @anthropic-ai/sdk) to summarise each report's
# document. Get a key at https://console.anthropic.com/settings/keys - see
# README.md's "Summarise" section for cost notes.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use for summarisation. Defaults to
# claude-haiku-4-5 (fast/cheap, plenty for a short bullet-point summary).
# Override for higher-quality summaries at Opus-tier pricing, e.g.:
# ANTHROPIC_MODEL=claude-opus-5

# Optional: how many characters of extracted document text to send in the
# prompt (defaults to 8000, comfortably inside every current Claude model's
# context window). Mainly a cost/latency knob for very long filings.
# SUMMARISE_MAX_INPUT_CHARS=8000
